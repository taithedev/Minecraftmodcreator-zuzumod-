{
  "name": "zuzumod-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs",
    "mcp": "node server/mcp.mjs",
    "test": "node --test tests/*.test.mjs",
    "package:win": "npm run build && node desktop/generate-icon.mjs && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@monaco-editor/react": "^4.7.0",
    "adm-zip": "^0.5.16",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "dev.zuzumod.studio",
    "productName": "ZuzuMod Studio",
    "artifactName": "ZuzuMod-Studio-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "desktop/main.mjs",
      "desktop/icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZuzuMod Studio"
    }
  }
}
